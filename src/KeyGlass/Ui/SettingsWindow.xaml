<Window x:Class="KeyGlass.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyGlass 设置（不要采集这个）"
        Width="620" Height="780"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F6F7F9"
        Foreground="#1B1F27"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#6B7686"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6BFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E2E6ED"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#D3D9E2"/>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,20,0,10"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#2B303A"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1B1F27"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#2B303A"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1B1F27"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2A61E8"/>
      <Setter Property="Padding" Value="20,7"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="26,22,26,0">
      <TextBlock Text="KeyGlass 键影" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Windows 11 实时输入可视化 · 针对 B 站直播姬「窗口捕获」优化"
                 Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,4,10,0">
      <StackPanel Margin="0,0,12,12">

        <TextBlock Text="采集与显示器" Style="{StaticResource Section}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="采集模式" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbMode" Grid.Column="1">
            <ComboBoxItem Content="色度键绿幕（直播姬首选）" Tag="Chroma"/>
            <ComboBoxItem Content="透明叠加（WGC 窗口捕获）" Tag="Transparent"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="输入引擎" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbEngine" Grid.Column="1">
            <ComboBoxItem Content="自动：原始输入 + 轮询兜底（推荐）" Tag="Auto"/>
            <ComboBoxItem Content="只用原始输入（前台才准）" Tag="RawInput"/>
            <ComboBoxItem Content="低级钩子（可能被 360/火绒 拦截）" Tag="LowLevelHook"/>
            <ComboBoxItem Content="只用轮询（最不挑权限，无滚轮）" Tag="Polling"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="绿幕颜色" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbChroma" Grid.Column="1">
            <ComboBoxItem Content="标准绿 #00B140（推荐）" Tag="#00B140"/>
            <ComboBoxItem Content="纯绿 #00FF00" Tag="#00FF00"/>
            <ComboBoxItem Content="品红 #FF00FF" Tag="#FF00FF"/>
            <ComboBoxItem Content="青绿 #00E5A0" Tag="#00E5A0"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="目标显示器" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbMonitor" Grid.Column="1"/>
        </Grid>

        <TextBlock Text="位置与尺寸" Style="{StaticResource Section}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="停靠位置" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbAnchor" Grid.Column="1">
            <ComboBoxItem Content="左上" Tag="TL"/>
            <ComboBoxItem Content="顶部居中" Tag="TC"/>
            <ComboBoxItem Content="右上" Tag="TR"/>
            <ComboBoxItem Content="左侧居中" Tag="ML"/>
            <ComboBoxItem Content="正中" Tag="MC"/>
            <ComboBoxItem Content="右侧居中" Tag="MR"/>
            <ComboBoxItem Content="左下" Tag="BL"/>
            <ComboBoxItem Content="底部居中" Tag="BC"/>
            <ComboBoxItem Content="右下" Tag="BR"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="水平边距" Style="{StaticResource RowLabel}"/>
          <Slider x:Name="sldMarginX" Grid.Column="1" Minimum="0" Maximum="600" TickFrequency="4"
                  IsSnapToTickEnabled="True" SmallChange="4" LargeChange="40"/>
          <TextBlock x:Name="txtMarginX" Grid.Column="2" Style="{StaticResource ValueText}"/>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="垂直边距" Style="{StaticResource RowLabel}"/>
          <Slider x:Name="sldMarginY" Grid.Column="1" Minimum="0" Maximum="600" TickFrequency="4"
                  IsSnapToTickEnabled="True" SmallChange="4" LargeChange="40"/>
          <TextBlock x:Name="txtMarginY" Grid.Column="2" Style="{StaticResource ValueText}"/>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="整体缩放" Style="{StaticResource RowLabel}"/>
          <Slider x:Name="sldScale" Grid.Column="1" Minimum="0.6" Maximum="2.0" TickFrequency="0.05"
                  IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.1"/>
          <TextBlock x:Name="txtScale" Grid.Column="2" Style="{StaticResource ValueText}"/>
        </Grid>

        <TextBlock Text="外观" Style="{StaticResource Section}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="配色主题" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbTheme" Grid.Column="1">
            <ComboBoxItem Content="Midnight · 午夜蓝" Tag="Midnight"/>
            <ComboBoxItem Content="Carbon · 石墨黑" Tag="Carbon"/>
            <ComboBoxItem Content="Sakura · 樱粉" Tag="Sakura"/>
            <ComboBoxItem Content="Lime · 青柠" Tag="Lime"/>
            <ComboBoxItem Content="BiliPink · B站粉" Tag="BiliPink"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="不透明度" Style="{StaticResource RowLabel}"/>
          <Slider x:Name="sldOpacity" Grid.Column="1" Minimum="0.4" Maximum="1.0" TickFrequency="0.02"
                  IsSnapToTickEnabled="True" SmallChange="0.02" LargeChange="0.1"/>
          <TextBlock x:Name="txtOpacity" Grid.Column="2" Style="{StaticResource ValueText}"/>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="键帽数量" Style="{StaticResource RowLabel}"/>
          <ComboBox x:Name="cmbChips" Grid.Column="1">
            <ComboBoxItem Content="4 个（极简）" Tag="4"/>
            <ComboBoxItem Content="5 个" Tag="5"/>
            <ComboBoxItem Content="6 个（默认）" Tag="6"/>
            <ComboBoxItem Content="7 个" Tag="7"/>
            <ComboBoxItem Content="8 个（密集）" Tag="8"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="48"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="键帽停留" Style="{StaticResource RowLabel}"/>
          <Slider x:Name="sldLinger" Grid.Column="1" Minimum="0" Maximum="3000" TickFrequency="50"
                  IsSnapToTickEnabled="True" SmallChange="50" LargeChange="200"/>
          <TextBlock x:Name="txtLinger" Grid.Column="2" Style="{StaticResource ValueText}"/>
        </Grid>

        <TextBlock Text="显示内容" Style="{StaticResource Section}"/>
        <WrapPanel>
          <CheckBox x:Name="chkMouse" Content="鼠标按键" Margin="0,0,24,8"/>
          <CheckBox x:Name="chkStats" Content="KPS / CPS 统计" Margin="0,0,24,8"/>
          <CheckBox x:Name="chkMods" Content="修饰键胶囊" Margin="0,0,24,8"/>
          <CheckBox x:Name="chkHud" Content="延迟 HUD（调试用）" Margin="0,0,24,8"/>
        </WrapPanel>

        <TextBlock Text="窗口行为" Style="{StaticResource Section}"/>
        <WrapPanel>
          <CheckBox x:Name="chkHideAltTab" Content="从 Alt+Tab 隐藏" Margin="0,0,24,8"/>
          <CheckBox x:Name="chkHideOnScreen" Content="不在我的屏幕上显示（只给直播姬采集）" Margin="0,0,24,8"/>
          <CheckBox x:Name="chkStartHidden" Content="启动时隐藏" Margin="0,0,24,8"/>
        </WrapPanel>

        <TextBlock Text="直播姬接入步骤" Style="{StaticResource Section}"/>
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#4A5261" LineHeight="20">
            1. 保持「采集模式」为色度键绿幕（默认）。<LineBreak/>
            2. 直播姬 → 添加来源 → 窗口捕获 → 选择窗口「KeyGlass Overlay」。<LineBreak/>
            3. 在该来源上加滤镜 → 色度键，颜色取 #00B140（与上表一致），相似度 15%~25%。<LineBreak/>
            4. 找不到窗口时：先关闭「从 Alt+Tab 隐藏」；仍找不到则改用「显示器捕获 + 裁剪」。<LineBreak/>
            5. 布局优先级：避开画面主体与弹幕区，默认右下角距边缘 48px。
          </TextBlock>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="#E7EAEF" BorderThickness="0,1,0,0" Padding="26,14">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="btnDefaults" Content="恢复默认" Margin="0,0,10,0"/>
          <Button x:Name="btnFolder" Content="打开配置目录"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btnClose" Content="关闭并保存" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
